# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Vector store / generated data ---
backend/app/data/chroma/
# Downloaded FlashRank reranker model (054-rag-block-expansion); fetched on first
# use / pre-baked into the Docker image, never committed.
backend/app/data/flashrank/
*.sqlite3

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.local

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Understand-Anything knowledge graph ---
# Commit the graph itself (knowledge-graph.json, meta.json, fingerprints.json,
# config.json, .understandignore) so the team can view it without re-scanning.
# Ignore only the run scratch (intermediate artifacts, dashboard log, trash).
.understand-anything/intermediate/
.understand-anything/tmp/
.understand-anything/tmp-dashboard.log
.understand-anything/.trash-*
